data class CodeTypographyConfig(
    val fontFamily: FontFamily = FontFamily.Monospace,
    val fontSize: TextUnit = 12.sp,
    val lineHeight: TextUnit = 16.sp
)

val CodeTypographyConfig = CodeTypographyConfig()
